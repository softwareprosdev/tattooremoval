# ─────────────────────────────────────────────────────────────
# AKASHA LASER STUDIO — Environment Configuration
# Copy this file to .env.local for local development, and mirror
# these into your hosting provider's (e.g. Vercel) env settings.
# ─────────────────────────────────────────────────────────────

# --- Supabase (lead storage) ---
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used by API routes to insert leads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (spam / bot protection on forms) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Resend (transactional email: lead notifications + confirmations) ---
RESEND_API_KEY=
# Verified sending domain/address in Resend.
RESEND_FROM_EMAIL="Akasha Laser Studio <consultations@akashalaser.com>"
# Where new-lead notifications are sent internally.
BUSINESS_NOTIFICATION_EMAIL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.akashalaser.com

# --- Analytics (optional; leave blank to disable) ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
